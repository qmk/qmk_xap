{
    // Schema version of this remap file (independent of QMK keycode versions).
    "version": "1",

    // QMK keycode spec version this file is authored against. When the active
    // catalog version differs, the GUI gets a raw fallback view (one tab per
    // generated group) and none of these overrides apply.
    "target_keycode_version": "0.0.8",

    // Top-level tabs in display order. Each tab has one or more subgroups.
    // Subgroup populators:
    //   - `keys: [...]`: explicit list of key names from the target version.
    //   - `from_group: "X"`: every catalog key whose generated group == X
    //     and that hasn't already been claimed by an earlier subgroup.
    // Hidden keys never land in normal subgroups; they always go to the
    // synthesized "Hidden" tab.
    "tabs": [
        {
            "id": "basic",
            "label": "Basic",
            "subgroups": [
                // ANSI keyboard layout. The Vue component renders this
                // subgroup specially when render_mode == "ansi". Modifier
                // keycodes share this layout (left/right Shift, Ctrl, Alt,
                // GUI all have ANSI slots), so they're pulled in here rather
                // than living in a separate subgroup.
                {
                    "id": "ansi",
                    "label": "Standard",
                    "render_mode": "ansi",
                    "from_groups": ["basic", "modifiers"]
                },
                {
                    "id": "blank",
                    "label": "Blank",
                    "keys": ["KC_NO", "KC_TRANSPARENT"]
                },
                {
                    "id": "extended_f",
                    "label": "Extended F-Keys",
                    "keys": [
                        "KC_F13", "KC_F14", "KC_F15", "KC_F16", "KC_F17", "KC_F18",
                        "KC_F19", "KC_F20", "KC_F21", "KC_F22", "KC_F23", "KC_F24"
                    ]
                },
                {
                    "id": "non_us",
                    "label": "Non-US",
                    "keys": ["KC_NONUS_HASH", "KC_NONUS_BACKSLASH"]
                },
                {
                    "id": "locking",
                    "label": "Locking Keys",
                    "keys": ["KC_LOCKING_CAPS_LOCK", "KC_LOCKING_NUM_LOCK", "KC_LOCKING_SCROLL_LOCK"]
                },
                {
                    "id": "numpad_extras",
                    "label": "Numpad Extras",
                    "keys": ["KC_KP_EQUAL", "KC_KP_EQUAL_AS400", "KC_KP_COMMA"]
                },
                {
                    "id": "commands",
                    "label": "Commands",
                    "keys": [
                        "KC_KB_POWER", "KC_EXECUTE", "KC_HELP", "KC_MENU", "KC_SELECT", "KC_STOP",
                        "KC_AGAIN", "KC_UNDO", "KC_CUT", "KC_COPY", "KC_PASTE", "KC_FIND",
                        "KC_KB_MUTE", "KC_KB_VOLUME_UP", "KC_KB_VOLUME_DOWN",
                        "KC_ALTERNATE_ERASE", "KC_SYSTEM_REQUEST", "KC_CANCEL", "KC_CLEAR",
                        "KC_PRIOR", "KC_RETURN", "KC_SEPARATOR", "KC_OUT", "KC_OPER",
                        "KC_CLEAR_AGAIN", "KC_CRSEL", "KC_EXSEL"
                    ]
                },
                {
                    "id": "international",
                    "label": "International",
                    "keys": [
                        "KC_INTERNATIONAL_1", "KC_INTERNATIONAL_2", "KC_INTERNATIONAL_3",
                        "KC_INTERNATIONAL_4", "KC_INTERNATIONAL_5", "KC_INTERNATIONAL_6",
                        "KC_INTERNATIONAL_7", "KC_INTERNATIONAL_8", "KC_INTERNATIONAL_9",
                        "KC_LANGUAGE_1", "KC_LANGUAGE_2", "KC_LANGUAGE_3", "KC_LANGUAGE_4",
                        "KC_LANGUAGE_5", "KC_LANGUAGE_6", "KC_LANGUAGE_7", "KC_LANGUAGE_8",
                        "KC_LANGUAGE_9"
                    ]
                }
            ]
        },
        // Parameterised keycodes. Each template subgroup expands at render
        // time against the connected keyboard's layer count.
        {
            "id": "layer",
            "label": "Layer",
            "color": "blue",
            "subgroups": [
                { "id": "mo",  "label": "Momentary (MO)",        "template": { "kind": "MO"  } },
                { "id": "tg",  "label": "Toggle (TG)",           "template": { "kind": "TG"  } },
                { "id": "to",  "label": "Activate (TO)",         "template": { "kind": "TO"  } },
                { "id": "df",  "label": "Default (DF)",          "template": { "kind": "DF"  } },
                { "id": "osl", "label": "One-Shot Layer (OSL)",  "template": { "kind": "OSL" } },
                { "id": "tt",  "label": "Tap-Toggle (TT)",       "template": { "kind": "TT"  } },
                { "id": "pdf", "label": "Persistent Default (PDF)", "template": { "kind": "PDF" } },
                { "id": "lt",  "label": "Layer-Tap (LT)",        "template": { "kind": "LT"  } }
            ]
        },
        {
            "id": "modtap",
            "label": "Mod-Tap",
            "color": "purple",
            "subgroups": [
                {
                    "id": "mt",
                    "label": "Hold Modifier / Tap Key",
                    "template": {
                        "kind": "MT",
                        "mods": [
                            "LSFT", "LCTL", "LALT", "LGUI",
                            "RSFT", "RCTL", "RALT", "RGUI",
                            "LCA", "LCAG", "MEH", "HYPR"
                        ]
                    }
                }
            ]
        },
        {
            "id": "layer_mod",
            "label": "Layer-Mod",
            "color": "cyan",
            "subgroups": [
                { "id": "lm", "label": "Layer + Modifier (LM)", "template": { "kind": "LM" } }
            ]
        },
        {
            "id": "modified",
            "label": "Modified",
            "color": "orange",
            "subgroups": [
                {
                    "id": "qk_mods",
                    "label": "Modifier + Key",
                    "template": {
                        "kind": "QK_MODS",
                        "mods": [
                            "LSFT", "LCTL", "LALT", "LGUI",
                            "RSFT", "RCTL", "RALT", "RGUI",
                            "LCA", "LCAG", "MEH", "HYPR"
                        ]
                    }
                }
            ]
        },
        {
            "id": "lighting",
            "label": "Lighting",
            "subgroups": [
                { "id": "backlight",  "label": "Backlight",  "from_group": "backlight" },
                { "id": "led_matrix", "label": "LED Matrix", "from_group": "led_matrix" },
                { "id": "rgb",        "label": "RGB",        "from_group": "rgb" },
                { "id": "rgb_matrix", "label": "RGB Matrix", "from_group": "rgb_matrix" },
                { "id": "underglow",  "label": "Underglow",  "from_group": "underglow" }
            ]
        },
        {
            "id": "system",
            "label": "System",
            "subgroups": [
                { "id": "system", "label": "System", "from_group": "system" },
                { "id": "media",  "label": "Media",  "from_group": "media" }
            ]
        },
        { "id": "mouse", "label": "Mouse", "subgroups": [{ "id": "mouse", "from_group": "mouse" }] },
        {
            "id": "qmk",
            "label": "QMK",
            "subgroups": [
                { "id": "quantum",    "label": "Quantum",    "from_group": "quantum" },
                { "id": "magic",      "label": "Magic",      "from_group": "magic" },
                { "id": "swap_hands", "label": "Swap Hands", "from_group": "swap_hands" },
                { "id": "connection", "label": "Connection", "from_group": "connection" },
                { "id": "kb",         "label": "Keyboard",   "from_group": "kb" },
                { "id": "audio",      "label": "Audio",      "from_group": "audio" }
            ]
        },
        { "id": "macro", "label": "Macro", "subgroups": [{ "id": "macro", "from_group": "macro" }] },
        {
            "id": "music",
            "label": "MIDI",
            "subgroups": [
                { "id": "midi",      "label": "MIDI",      "from_group": "midi" },
                { "id": "sequencer", "label": "Sequencer", "from_group": "sequencer" }
            ]
        },
        { "id": "joystick",            "label": "Joystick",            "subgroups": [{ "id": "joystick",            "from_group": "joystick" }] },
        { "id": "programmable_button", "label": "Programmable",        "subgroups": [{ "id": "programmable_button", "from_group": "programmable_button" }] },
        { "id": "steno",               "label": "Steno",               "subgroups": [{ "id": "steno",               "from_group": "steno" }] },
        { "id": "user",                "label": "User",                "subgroups": [{ "id": "user",                "from_group": "user" }] },
        { "id": "internal",            "label": "Internal",            "subgroups": [{ "id": "internal",            "from_group": "internal" }] }
    ],

    // Per-key overrides. Keys are exact `key` field names from the target
    // version's generated hjson. Descriptions are sourced from the QMK docs
    // (qmk_firmware/docs/keycodes_basic.md and keycodes_magic.md).
    "keycodes": {
        // Blank behavior keys shown in Basic > Blank immediately below ANSI.
        "KC_NO":          { "label": "", "description": "Ignore this key (NOOP)." },
        "KC_TRANSPARENT": { "description": "Use the next lowest non-transparent key." },

        // Letters
        "KC_A": { "description": "a and A" },
        "KC_B": { "description": "b and B" },
        "KC_C": { "description": "c and C" },
        "KC_D": { "description": "d and D" },
        "KC_E": { "description": "e and E" },
        "KC_F": { "description": "f and F" },
        "KC_G": { "description": "g and G" },
        "KC_H": { "description": "h and H" },
        "KC_I": { "description": "i and I" },
        "KC_J": { "description": "j and J" },
        "KC_K": { "description": "k and K" },
        "KC_L": { "description": "l and L" },
        "KC_M": { "description": "m and M" },
        "KC_N": { "description": "n and N" },
        "KC_O": { "description": "o and O" },
        "KC_P": { "description": "p and P" },
        "KC_Q": { "description": "q and Q" },
        "KC_R": { "description": "r and R" },
        "KC_S": { "description": "s and S" },
        "KC_T": { "description": "t and T" },
        "KC_U": { "description": "u and U" },
        "KC_V": { "description": "v and V" },
        "KC_W": { "description": "w and W" },
        "KC_X": { "description": "x and X" },
        "KC_Y": { "description": "y and Y" },
        "KC_Z": { "description": "z and Z" },

        // Number row
        "KC_1": { "description": "1 and !" },
        "KC_2": { "description": "2 and @" },
        "KC_3": { "description": "3 and #" },
        "KC_4": { "description": "4 and $" },
        "KC_5": { "description": "5 and %" },
        "KC_6": { "description": "6 and ^" },
        "KC_7": { "description": "7 and &" },
        "KC_8": { "description": "8 and *" },
        "KC_9": { "description": "9 and (" },
        "KC_0": { "description": "0 and )" },

        // F-keys
        "KC_F1":  { "description": "F1" },
        "KC_F2":  { "description": "F2" },
        "KC_F3":  { "description": "F3" },
        "KC_F4":  { "description": "F4" },
        "KC_F5":  { "description": "F5" },
        "KC_F6":  { "description": "F6" },
        "KC_F7":  { "description": "F7" },
        "KC_F8":  { "description": "F8" },
        "KC_F9":  { "description": "F9" },
        "KC_F10": { "description": "F10" },
        "KC_F11": { "description": "F11" },
        "KC_F12": { "description": "F12" },
        "KC_F13": { "description": "F13" },
        "KC_F14": { "description": "F14" },
