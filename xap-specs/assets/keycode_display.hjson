        // Magic keycodes (qmk_firmware/docs/keycodes_magic.md)
        "QK_MAGIC_SWAP_CONTROL_CAPS_LOCK":     { "description": "Swap Caps Lock and Left Control" },
        "QK_MAGIC_UNSWAP_CONTROL_CAPS_LOCK":   { "description": "Unswap Caps Lock and Left Control" },
