        "KC_F20": { "description": "F20" },
        "KC_F21": { "description": "F21" },
        "KC_F22": { "description": "F22" },
        "KC_F23": { "description": "F23" },
        "KC_F24": { "description": "F24" },

        // Punctuation
        "KC_ENTER":           { "description": "Return (Enter)" },
        "KC_ESCAPE":          { "description": "Escape" },
        "KC_BACKSPACE":       { "description": "Delete (Backspace)" },
        "KC_TAB":             { "description": "Tab" },
        "KC_SPACE":           { "description": "Spacebar" },
        "KC_MINUS":           { "description": "- and _" },
        "KC_EQUAL":           { "description": "= and +" },
        "KC_LEFT_BRACKET":    { "description": "[ and {" },
        "KC_RIGHT_BRACKET":   { "description": "] and }" },
        "KC_BACKSLASH":       { "description": "\\ and |" },
        "KC_NONUS_HASH":      { "description": "Non-US # and ~" },
        "KC_SEMICOLON":       { "description": "; and :" },
        "KC_QUOTE":           { "description": "' and \"" },
        "KC_GRAVE":           { "description": "` and ~" },
        "KC_COMMA":           { "description": ", and <" },
        "KC_DOT":             { "description": ". and >" },
        "KC_SLASH":           { "description": "/ and ?" },
        "KC_NONUS_BACKSLASH": { "description": "Non-US \\ and |" },

        // Lock keys
        "KC_CAPS_LOCK":           { "description": "Caps Lock" },
        "KC_SCROLL_LOCK":         { "description": "Scroll Lock, Brightness Down (macOS)" },
        "KC_NUM_LOCK":            { "description": "Keypad Num Lock and Clear" },
        "KC_LOCKING_CAPS_LOCK":   { "description": "Locking Caps Lock" },
        "KC_LOCKING_NUM_LOCK":    { "description": "Locking Num Lock" },
