        "QK_MAGIC_TOGGLE_CTL_GUI":             { "description": "Toggle Control and GUI swap on both sides" },
        "QK_MAGIC_SWAP_LALT_LGUI":             { "description": "Swap Left Alt and GUI" },
        "QK_MAGIC_UNSWAP_LALT_LGUI":           { "description": "Unswap Left Alt and GUI" },
        "QK_MAGIC_SWAP_RALT_RGUI":             { "description": "Swap Right Alt and GUI" },
        "QK_MAGIC_UNSWAP_RALT_RGUI":           { "description": "Unswap Right Alt and GUI" },
        "QK_MAGIC_SWAP_ALT_GUI":               { "description": "Swap Alt and GUI on both sides" },
        "QK_MAGIC_UNSWAP_ALT_GUI":             { "description": "Unswap Alt and GUI on both sides" },
        "QK_MAGIC_TOGGLE_ALT_GUI":             { "description": "Toggle Alt and GUI swap on both sides" },
        "QK_MAGIC_GUI_OFF":                    { "description": "Disable the GUI keys" },
        "QK_MAGIC_GUI_ON":                     { "description": "Enable the GUI keys" },
        "QK_MAGIC_TOGGLE_GUI":                 { "description": "Toggles the status of the GUI keys" },
        "QK_MAGIC_SWAP_GRAVE_ESC":             { "description": "Swap ` and Escape" },
